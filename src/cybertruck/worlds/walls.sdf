<?xml version="1.0"?>
<!--
  10 m x 10 m room for SLAM. Walls are 2.5 m tall so the 1.5 m lidar
  scan plane intersects them; two interior pillars give loop closure
  something to match.
-->
<sdf version="1.9">
  <world name="walls">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>

    <scene>
      <ambient>0.7 0.7 0.7 1</ambient>
      <background>0.75 0.80 0.90 1</background>
      <grid>true</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- four walls of the 10 x 10 m room -->
    <model name="wall_x_pos">
      <static>true</static>
      <pose>5.0 0.0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 10.2 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 10.2 2.5</size></box></geometry>
          <material>
            <ambient>0.75 0.75 0.75 1</ambient>
            <diffuse>0.75 0.75 0.75 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_x_neg">
      <static>true</static>
      <pose>-5.0 0.0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 10.2 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 10.2 2.5</size></box></geometry>
          <material>
            <ambient>0.75 0.75 0.75 1</ambient>
            <diffuse>0.75 0.75 0.75 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_y_pos">
      <static>true</static>
      <pose>0.0 5.0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>10.2 0.2 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10.2 0.2 2.5</size></box></geometry>
          <material>
            <ambient>0.70 0.70 0.75 1</ambient>
            <diffuse>0.70 0.70 0.75 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_y_neg">
      <static>true</static>
      <pose>0.0 -5.0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>10.2 0.2 2.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10.2 0.2 2.5</size></box></geometry>
          <material>
            <ambient>0.70 0.70 0.75 1</ambient>
            <diffuse>0.70 0.70 0.75 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- interior features -->
    <model name="pillar_a">
      <static>true</static>
      <pose>2.0 1.5 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.6 0.6 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.6 0.6 2.0</size></box></geometry>
        </visual>
      </link>
    </model>

    <model name="pillar_b">
      <static>true</static>
      <pose>-2.5 -2.0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.6 0.6 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.6 0.6 2.0</size></box></geometry>
        </visual>
      </link>
    </model>

  </world>
</sdf>
