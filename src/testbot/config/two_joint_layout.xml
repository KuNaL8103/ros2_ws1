<?xml version='1.0' encoding='UTF-8'?>
<!--
  PlotJuggler layout for the testbot bicep-curl demo.

  Two plots: right elbow and left elbow, fed by /joint_states.
  PlotJuggler expands JointState arrays using the joint names, so the
  series are /joint_states/<joint_name>/position.

  Load with:
      ros2 run plotjuggler plotjuggler -l <path>/two_joint_layout.xml
  or:
      ros2 launch testbot plot.launch.py
-->
<root>
 <tabbed_widget name="Main Window" parent="main_window">
  <Tab tab_name="elbows" containers="1">
   <Container>
    <DockSplitter sizes="0.5;0.5" orientation="-" count="2">
     <DockArea name="right elbow">
      <plot mode="TimeSeries" style="Lines" flip_x="false" flip_y="false">
       <range top="0.600000" right="10.000000" bottom="-0.600000" left="0.000000"/>
       <limitY/>
       <curve name="/joint_states/upper_arm_to_lower_arm_right/position" color="#1f77b4"/>
      </plot>
     </DockArea>
     <DockArea name="left elbow">
      <plot mode="TimeSeries" style="Lines" flip_x="false" flip_y="false">
       <range top="0.600000" right="10.000000" bottom="-0.600000" left="0.000000"/>
       <limitY/>
       <curve name="/joint_states/upper_arm_to_lower_arm_left/position" color="#d62728"/>
      </plot>
     </DockArea>
    </DockSplitter>
   </Container>
  </Tab>
  <currentTabIndex index="0"/>
 </tabbed_widget>
 <use_relative_time_offset enabled="1"/>
 <!-- - - - - - - - - - - - - - - -->
 <Plugins>
  <plugin ID="DataLoad CSV">
   <default delimiter="0" time_axis=""/>
  </plugin>
  <plugin ID="DataLoad ROS2 bags">
   <use_header_stamp value="false"/>
   <discard_large_arrays value="true"/>
   <max_array_size value="100"/>
   <boolean_strings_to_number value="true"/>
   <remove_suffix_from_strings value="true"/>
   <selected_topics value=""/>
  </plugin>
  <plugin ID="DataLoad ULog"/>
  <plugin ID="ROS2 Topic Subscriber">
   <use_header_stamp value="false"/>
   <discard_large_arrays value="true"/>
   <max_array_size value="100"/>
   <boolean_strings_to_number value="true"/>
   <remove_suffix_from_strings value="true"/>
   <selected_topics value="/joint_states"/>
  </plugin>
  <plugin ID="UDP Server"/>
  <plugin ID="WebSocket Server"/>
  <plugin ID="ZMQ Subscriber"/>
  <plugin ID="CSV Exporter" status="idle"/>
 </Plugins>
 <!-- - - - - - - - - - - - - - - -->
 <previouslyLoaded_Datafiles/>
 <previouslyLoaded_Streamer name="ROS2 Topic Subscriber"/>
 <customMathEquations/>
 <snippets/>
</root>
