      <origin rpy="1.5708 0 0" xyz="0 0 0"/>
    </collision>
    <inertial>
      <mass value="20.0"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <!-- axle along Y after the visual rotation above -->
      <inertia ixx="1.02153125" ixy="0.0" ixz="0.0" iyy="1.7430625" iyz="0.0" izz="1.02153125"/>
    </inertial>
  </link>
  <joint name="body_to_front_right_wheel" type="continuous">
    <parent link="body"/>
    <child link="front_right_wheel"/>
    <origin rpy="0 0 0" xyz="1.4 -0.73 0.4175"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.05" friction="0.0"/>
  </joint>
  <joint name="body_to_lidar" type="fixed">
    <parent link="body"/>
    <child link="lidar_link"/>
    <origin rpy="0 0 0" xyz="0 0 1.5"/>
  </joint>
  <!-- front wheels are casters: no friction at all -->
  <gazebo reference="front_left_wheel">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>
  <gazebo reference="front_right_wheel">
    <mu1>0.0</mu1>
    <mu2>0.0</mu2>
  </gazebo>
  <!-- rear wheels need real traction -->
  <gazebo reference="back_left_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="back_right_wheel">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <!-- 360 degree 2D lidar for SLAM; scan plane 1.5 m above the floor -->
  <gazebo reference="lidar_link">
    <sensor name="lidar_sensor" type="gpu_lidar">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <topic>scan</topic>
      <lidar>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0.0</min_angle>
            <max_angle>0.0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.1</min>
          <max>20.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>
  <!-- =========================== ros2_control ======================== -->
  <ros2_control name="CybertruckSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="body_to_back_left_wheel">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="body_to_back_right_wheel">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <!-- passive front wheels: state only, so joint_state_broadcaster
         reports them and robot_state_publisher can build their TF -->
    <joint name="body_to_front_left_wheel">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="body_to_front_right_wheel">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>/home/kunal/ros2_ws1/install/cybertruck/share/cybertruck/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>
</robot>
