<!--
  Tesla-bot style upper body.

  Kinematic chain (per the lesson):
      world -> head -> body -> shoulder -> upper_arm -> lower_arm -> hand

  world_to_head and head_to_body are fixed. Shoulders and elbows rotate
  about Z, so the arms swing in the XY plane like clock hands.
  At zero the hand is 0.3 + 0.3 = 0.6 m from the shoulder.
-->
<robot name="testbot">
  <material name="white">
    <color rgba="0.90 0.90 0.90 1.0"/>
  </material>
  <material name="grey">
    <color rgba="0.45 0.45 0.45 1.0"/>
  </material>
  <material name="blue">
    <color rgba="0.10 0.25 0.80 1.0"/>
  </material>
  <material name="red">
    <color rgba="0.90 0.10 0.10 1.0"/>
  </material>
  <!-- ============================ links ============================= -->
  <!-- Gazebo treats a root link named "world" as the fixed world frame -->
  <link name="world"/>
  <link name="head">
    <visual>
      <geometry>
        <sphere radius="0.15"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.15"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.018" ixy="0.0" ixz="0.0" iyy="0.018" iyz="0.0" izz="0.018"/>
    </inertial>
  </link>
  <!-- body frame at the top of the torso; the box reaches down to z = 0 -->
  <link name="body">
    <visual>
      <geometry>
        <box size="0.5 0.4 1.05"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 -0.525"/>
      <material name="white"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.5 0.4 1.05"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 -0.525"/>
    </collision>
    <inertial>
      <mass value="10.0"/>
      <origin rpy="0 0 0" xyz="0 0 -0.525"/>
      <inertia ixx="1.0520833333333335" ixy="0.0" ixz="0.0" iyy="1.1270833333333334" iyz="0.0" izz="0.34166666666666673"/>
    </inertial>
  </link>
  <link name="upper_arm_right">
    <visual>
      <geometry>
        <box size="0.3 0.08 0.08"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0.15 0 0"/>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.3 0.08 0.08"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0.15 0 0"/>
    </collision>
    <inertial>
      <mass value="0.8"/>
      <origin rpy="0 0 0" xyz="0.15 0 0"/>
      <inertia ixx="0.0008533333333333334" ixy="0.0" ixz="0.0" iyy="0.006426666666666667" iyz="0.0" izz="0.006426666666666667"/>
    </inertial>
  </link>
  <link name="lower_arm_right">
    <visual>
      <geometry>
        <box size="0.3 0.08 0.08"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0.15 0 0"/>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.3 0.08 0.08"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0.15 0 0"/>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <origin rpy="0 0 0" xyz="0.15 0 0"/>
      <inertia ixx="0.0005333333333333334" ixy="0.0" ixz="0.0" iyy="0.004016666666666667" iyz="0.0" izz="0.004016666666666667"/>
    </inertial>
  </link>
  <link name="hand_right">
    <visual>
      <geometry>
        <sphere radius="0.06"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <material name="red"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.06"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.00028799999999999995" ixy="0.0" ixz="0.0" iyy="0.00028799999999999995" iyz="0.0" izz="0.00028799999999999995"/>
    </inertial>
  </link>
  <!-- shoulder: revolute about Z -->
  <joint name="body_to_upper_arm_right" type="revolute">
    <parent link="body"/>
    <child link="upper_arm_right"/>
    <origin rpy="0 0 0" xyz="0.28 0 -0.1"/>
    <axis xyz="0 0 1"/>
    <limit effort="30.0" lower="-1.5708" upper="1.5708" velocity="2.0"/>
    <dynamics damping="0.5" friction="0.05"/>
  </joint>
  <!-- elbow: the joint the trajectory controller drives -->
  <joint name="upper_arm_to_lower_arm_right" type="revolute">
    <parent link="upper_arm_right"/>
    <child link="lower_arm_right"/>
    <origin rpy="0 0 0" xyz="0.3 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="30.0" lower="-1.5708" upper="1.5708" velocity="2.0"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>
  <joint name="lower_arm_to_hand_right" type="fixed">
    <parent link="lower_arm_right"/>
    <child link="hand_right"/>
    <origin rpy="0 0 0" xyz="0.3 0 0"/>
  </joint>
  <link name="upper_arm_left">
    <visual>
      <geometry>
        <box size="0.3 0.08 0.08"/>
      </geometry>
      <origin rpy="0 0 0" xyz="-0.15 0 0"/>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.3 0.08 0.08"/>
      </geometry>
      <origin rpy="0 0 0" xyz="-0.15 0 0"/>
    </collision>
    <inertial>
      <mass value="0.8"/>
      <origin rpy="0 0 0" xyz="-0.15 0 0"/>
      <inertia ixx="0.0008533333333333334" ixy="0.0" ixz="0.0" iyy="0.006426666666666667" iyz="0.0" izz="0.006426666666666667"/>
    </inertial>
  </link>
  <link name="lower_arm_left">
    <visual>
      <geometry>
        <box size="0.3 0.08 0.08"/>
      </geometry>
      <origin rpy="0 0 0" xyz="-0.15 0 0"/>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.3 0.08 0.08"/>
      </geometry>
      <origin rpy="0 0 0" xyz="-0.15 0 0"/>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <origin rpy="0 0 0" xyz="-0.15 0 0"/>
      <inertia ixx="0.0005333333333333334" ixy="0.0" ixz="0.0" iyy="0.004016666666666667" iyz="0.0" izz="0.004016666666666667"/>
    </inertial>
  </link>
  <link name="hand_left">
    <visual>
      <geometry>
        <sphere radius="0.06"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <material name="red"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="0.06"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.00028799999999999995" ixy="0.0" ixz="0.0" iyy="0.00028799999999999995" iyz="0.0" izz="0.00028799999999999995"/>
    </inertial>
  </link>
  <!-- shoulder: revolute about Z -->
  <joint name="body_to_upper_arm_left" type="revolute">
    <parent link="body"/>
    <child link="upper_arm_left"/>
    <origin rpy="0 0 0" xyz="-0.28 0 -0.1"/>
    <axis xyz="0 0 1"/>
    <limit effort="30.0" lower="-1.5708" upper="1.5708" velocity="2.0"/>
    <dynamics damping="0.5" friction="0.05"/>
  </joint>
  <!-- elbow: the joint the trajectory controller drives -->
  <joint name="upper_arm_to_lower_arm_left" type="revolute">
    <parent link="upper_arm_left"/>
    <child link="lower_arm_left"/>
    <origin rpy="0 0 0" xyz="-0.3 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="30.0" lower="-1.5708" upper="1.5708" velocity="2.0"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>
  <joint name="lower_arm_to_hand_left" type="fixed">
    <parent link="lower_arm_left"/>
    <child link="hand_left"/>
    <origin rpy="0 0 0" xyz="-0.3 0 0"/>
  </joint>
  <!-- camera on the head, looking forward and tilted down towards the hands -->
  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.04 0.06 0.04"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <material name="grey"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.04 0.06 0.04"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.0000433" ixy="0.0" ixz="0.0" iyy="0.0000267" iyz="0.0" izz="0.0000433"/>
    </inertial>
  </link>
  <!-- optical frame: z forward, x right, y down (REP-103) -->
  <link name="camera_link_optical"/>
  <!-- =========================== joints ============================= -->
  <joint name="world_to_head" type="fixed">
    <parent link="world"/>
    <child link="head"/>
    <origin rpy="0 0 0" xyz="0 0 1.2"/>
  </joint>
  <joint name="head_to_body" type="fixed">
    <parent link="head"/>
    <child link="body"/>
    <origin rpy="0 0 0" xyz="0 0 -0.15"/>
  </joint>
  <!-- eye-level camera, tilted down ~0.5 rad to frame the hands -->
  <joint name="head_to_camera" type="fixed">
    <parent link="head"/>
    <child link="camera_link"/>
    <origin rpy="0 0.5 0" xyz="0.12 0 0.08"/>
  </joint>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_link_optical"/>
    <origin rpy="-1.5708 0 -1.5708" xyz="0 0 0"/>
  </joint>
  <!-- ====================== ros2_control ============================ -->
  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <!-- elbows: position command + full state feedback -->
    <joint name="upper_arm_to_lower_arm_right">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="upper_arm_to_lower_arm_left">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <!-- passive shoulders: state only, so joint_state_broadcaster
         reports them and robot_state_publisher can build their TF -->
    <joint name="body_to_upper_arm_right">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <joint name="body_to_upper_arm_left">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </ros2_control>
  <!-- ====================== Gazebo plugin =========================== -->
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>/home/kunal/ros2_ws1/install/testbot/share/testbot/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>
  <!--
    Gazebo Harmonic camera sensor. There is no libgazebo_ros_camera.so:
    gz-sim-sensors-system (in the world file) renders it, and
    ros_gz_bridge converts the gz.msgs.Image / CameraInfo to ROS.
  -->
  <gazebo reference="camera_link">
    <sensor name="camera" type="camera">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <topic>camera/image_raw</topic>
      <camera>
        <camera_info_topic>camera/camera_info</camera_info_topic>
        <horizontal_fov>1.0</horizontal_fov>
        <image>
          <format>R8G8B8</format>
          <width>640</width>
          <height>480</height>
        </image>
        <clip>
          <near>0.05</near>
          <far>100.0</far>
        </clip>
        <optical_frame_id>camera_link_optical</optical_frame_id>
      </camera>
    </sensor>
  </gazebo>
</robot>
